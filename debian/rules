#!/usr/bin/make -f
# Application en Python sans module installé dans site-packages : le code va dans
# /usr/share/sirene (privé), dh_python3 le compile à l'installation (py3compile).

%:
	dh $@ --with python3

override_dh_auto_build:
override_dh_auto_test:

override_dh_auto_install:
	install -d debian/sirene/usr/share/sirene
	cp -r sirene data debian/sirene/usr/share/sirene/
	find debian/sirene/usr/share/sirene -name __pycache__ -type d -prune -exec rm -rf {} +
	rm -f debian/sirene/usr/share/sirene/data/locale/*.pot

override_dh_python3:
	dh_python3 /usr/share/sirene
